# Local application settings.
APP_ENV=development
DEBUG_MODE=false
TEMP_DIR=temp
TEMP_FILE_MAX_AGE_HOURS=24
MAX_UPLOAD_MB=12
LOG_LEVEL=INFO

# Document AI provider: ollama | openai | gemini
DOCUMENT_AI_PROVIDER=gemini

# Model used by the selected document provider.
DOCUMENT_AI_MODEL=gemini-3.7-flash

# Gemini OpenAI-compatible API. Add the real key only to the ignored .env file.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_TIMEOUT_SECONDS=60
GEMINI_CREDENTIAL_FOCUS_TIMEOUT_SECONDS=12
GEMINI_REASONING_EFFORT=low

# Ollama local fallback. No API key is required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=420

# Optional OpenAI provider.
DOCUMENT_AI_API_KEY=
DOCUMENT_AI_TIMEOUT_SECONDS=90

# Controlled Phase 4 browser execution. Chromium uses a temporary private context.
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_SECONDS=30
BROWSER_NAVIGATION_TIMEOUT_SECONDS=45
BROWSER_MAX_SEARCH_RESULTS=8

# Phase 5 bounded retrieval and secure downloads
AGENT_MAX_STEPS=40
AGENT_MAX_NAVIGATIONS=24
AGENT_MAX_FORM_SUBMISSIONS=2
AGENT_MAX_WAIT_SECONDS=8
MAX_REPORT_DOWNLOAD_MB=25
INTERACTION_AI_PROVIDER=deterministic
INTERACTION_AI_MODEL=

# Optional administrator-managed legacy-host to verified HTTPS portal mapping.
# Values still pass the normal browser safety validation before navigation.
PORTAL_URL_OVERRIDES_JSON={}

# Optional administrator-managed HTTP legacy host to verified HTTPS origin mapping.
# Only GET navigations are upgraded; credentials are never replayed from HTTP POSTs.
PORTAL_HTTPS_HOST_REWRITES_JSON={}

# Legacy opt-in only. Allows sensitive fields and validated report downloads over
# an official portal's unencrypted HTTP connection. Keep false for deployment.
ALLOW_INSECURE_REPORT_PORTALS=false
