# Local application settings.
APP_ENV=development
DEBUG_MODE=false
TEMP_DIR=temp
TEMP_FILE_MAX_AGE_HOURS=24
MAX_UPLOAD_MB=12
LOG_LEVEL=INFO

# Free local Phase 2 document understanding. No API key is required.
DOCUMENT_AI_PROVIDER=ollama
DOCUMENT_AI_MODEL=qwen3-vl:4b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=420

# Optional OpenAI settings for a later paid deployment.
DOCUMENT_AI_API_KEY=
DOCUMENT_AI_TIMEOUT_SECONDS=90

# Controlled Phase 4 browser execution. Chromium uses a temporary private context.
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_SECONDS=30
BROWSER_NAVIGATION_TIMEOUT_SECONDS=45
BROWSER_MAX_SEARCH_RESULTS=8
